{
  "name": "numeros-publicos-painel",
  "version": "0.1.0",
  "private": true,
  "description": "Painel estático do Números Públicos. Lê o snapshot JSON gerado pelo motor Python.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/enxugar.mjs && node scripts/desidratar.mjs",
    "build:completo": "next build",
    "start": "node scripts/porta-livre.mjs 8791 && npx serve out -l 8791",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/registrar.mjs --test tests/*.test.mts",
    "conferir-links": "node scripts/conferir-links.mjs",
    "conferir-xlsx": "node scripts/conferir-xlsx.mjs out/dados/municipios.xlsx out/dados/municipios.csv",
    "medir-inp": "node scripts/medir-inp.mjs http://127.0.0.1:8791/",
    "indexnow": "node scripts/indexnow.mjs",
    "auditar": "node scripts/auditar.mjs http://127.0.0.1:8791 / /ajuda/ /ranking/gasto-com-pessoal/ /ranking/gasto-com-pessoal/?uf=ce /brasil/ /estado/ce/ /estado/rs/ /estado/df/ /estado/mt/ /municipio/presidente-medici-ro/ /municipio/imperatriz-ma/ /municipio/guaratinga-ba/ /municipio/apiai-sp/ /municipio/aparecida-sp/ /municipio/volta-redonda-rj/ /municipio/brasilia-df/ /municipio/boa-esperanca-do-norte-mt/"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "puppeteer-core": "25.12.0",
    "serve": "14.2.6",
    "typescript": "5.8.3"
  },
  "overrides": {
    "compression": "1.8.2"
  },
  "license": "AGPL-3.0-or-later"
}
