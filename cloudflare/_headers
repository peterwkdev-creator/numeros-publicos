# Cabeçalhos do Cloudflare Pages, copiados para o out/ pelo workflow
# .github/workflows/publicar-cloudflare.yml. Fica FORA de painel/ porque é
# configuração do Pages, não página: só o workflow o põe no out/.

# Segurança, em toda página (11/10/2026; até ali o Pages só mandava nosniff e
# referrer-policy). O site é estático, sem login nem formulário, e não carrega
# nada de fora: a CSP diz exatamente isso, e o que vier de outra origem passa a
# ser bloqueado em vez de rodar. script-src é só 'self' desde 17/10/2026: até
# ali levava 'unsafe-inline' pela capa, que hidratava; desde a desidratação
# nenhuma página tem <script> inline que execute (as 11.248 tags do build são
# type="module" com src; o JSON-LD é dado, e a CSP não o barra). Em style-src
# o 'unsafe-inline' fica, pelo <style> do mapa e pelas barras com style=.
# scripts/conferir-csp.mjs serve o out/ com ESTE arquivo e reprova qualquer
# violação; o CI o roda antes de publicar.
# HSTS sem includeSubDomains nem preload: preload é decisão de anos e difícil
# de desfazer, e fica para quando o domínio inteiro estiver conferido.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://resultados.tse.jus.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Cache longo: os nomes em /_next/static/ têm o hash do conteúdo, então um
# arquivo nunca muda sob o mesmo nome.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Os scripts de public/ saem do build minificados e com o hash do conteúdo
# no nome, em /js/ (scripts/versionar-js.mjs, 16/10/2026): o mesmo argumento.
# Até ali, max-age=14400 com must-revalidate: o script velho podia seguir 4 h
# no cache depois de uma publicação.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Os downloads ficam fora do índice dos buscadores (15/10/2026). O export do
# Search Console mostrou dados.csv entre as páginas "rastreadas, mas não
# indexadas": o CSV repete a página do município em outro formato, e cada um
# é mais uma URL rasa do mesmo molde na conta do Google. Quem baixa não muda
# nada. Um curinga por regra é o limite do Pages, daí uma regra por rota; o
# teste "todo download tem noindex" reprova rota de download nova sem regra.
/municipio/:slug/dados.csv
  X-Robots-Tag: noindex

/estado/:uf/dados.csv
  X-Robots-Tag: noindex

/brasil/:serie/dados.csv
  X-Robots-Tag: noindex

/dados/municipios.csv
  X-Robots-Tag: noindex

/dados/municipios.xlsx
  X-Robots-Tag: noindex

/dados/explorar/:indicador/dados.json
  X-Robots-Tag: noindex

# Os JSON que as páginas leem pelo script (a busca, a capa e o mapa das
# eleições): dado para o navegador, não página (27/10/2026).
/dados/indice.json
  X-Robots-Tag: noindex

/dados/capa.json
  X-Robots-Tag: noindex

/dados/eleicoes-2026-mapa.json
  X-Robots-Tag: noindex

# O endereço *.pages.dev serve o site inteiro, e sem isto o Google o indexaria
# como cópia do www. O canonical já aponta para o www, mas noindex no host da
# plataforma é o que a própria Cloudflare recomenda. Não afeta o domínio próprio.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
